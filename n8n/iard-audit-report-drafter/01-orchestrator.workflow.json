      "id": "261312e8-c28a-4bce-8af8-98487a7c25ea",
      "name": "Create Engagement Row",
      "notes": "chat_session_id ties the later refinement chat back to this engagement."
    },
    {
      "parameters": {
        "jsCode": "// Carries the original form's uploaded files forward into Intake & Parse,\n// one item per file actually attached, tagged with engagement_id + doc_type.\n// This closes the gap where only the new engagement row (no files) was being\n// passed through to the sub-workflow.\nconst formItem = $('Form Trigger: New Engagement').first();\nconst engagementId = $('Create Engagement Row').first().json.id;\n\n// FIX: n8n's binary-field-name sanitization is inconsistent about underscore count around\n// parenthesized text (e.g. \"Process Understanding (optional)\" -> \"Process_Understanding__optional_\"\n// with a DOUBLE underscore, not single as originally assumed) — found via a real form submission\n// that hit source_document's doc_type check constraint. Matching by prefix instead of exact string\n// so this isn't fragile to that kind of formatting quirk again.\nconst PREFIX_TO_DOC_TYPE = [\n  ['Completed_Audit_Working_File', 'completed_audit_working_file'],\n  ['Kick', 'kickoff_deck'],\n  ['Process_Understanding', 'process_understanding'],\n  ['Audit_Notification', 'audit_notification'],\n  ['Analysis_Sheet', 'analysis_sheet'],\n  ['Supporting_Evidence', 'supporting_evidence']\n];\nfunction classify(key) {\n  const hit = PREFIX_TO_DOC_TYPE.find(([prefix]) => key.startsWith(prefix));\n  return hit ? hit[1] : null;\n}\n\nconst binaryKeys = Object.keys(formItem.binary || {});\nif (binaryKeys.length === 0) {\n  // No files attached (e.g. a manual/API test run) — nothing to classify.\n  // Downstream 'Compute Input Gaps' will still correctly flag missing mandatory inputs.\n  return [{ json: { engagement_id: engagementId, doc_type: null, file_ref: null, no_files: true } }];\n}\n\nreturn binaryKeys\n  .map(key => {\n    const bin = formItem.binary[key];\n    const docType = classify(key);\n    if (!docType) {\n      // Don't silently write an invalid/unrecognised doc_type — surface it instead (FR-23 spirit).\n      throw new Error(`Could not classify uploaded field \"${key}\" (filename: ${bin.fileName || 'unknown'}) into a known input type.`);\n    }\n    return { json: { engagement_id: engagementId, doc_type: docType, file_ref: bin.fileName || key }, binary: { data: bin } };\n  });"
      },
