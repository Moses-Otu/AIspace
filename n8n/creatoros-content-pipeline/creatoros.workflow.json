        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  query: \"mutation CreateDraft($input: CreateDraftInput!) { createDraft(input: $input) { draft { id slug title } } }\",\n  variables: {\n    input: {\n      title: $(\"SEO Agent\").item.json.seoTitle,\n      contentMarkdown: $(\"SEO Agent\").item.json.article,\n      publicationId: \"REPLACE_WITH_PUBLICATION_ID\",\n      slug: $(\"SEO Agent\").item.json.slug,\n      metaTags: { description: $(\"SEO Agent\").item.json.description }\n    }\n  }\n}) }}",
